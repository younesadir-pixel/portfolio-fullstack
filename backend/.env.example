# Django Server Production Settings
DJANGO_SECRET_KEY=your-production-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-backend-domain.onrender.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-frontend-domain.vercel.app,https://your-backend-domain.onrender.com

# PostgreSQL Database (Optional for Production; SQLite is default)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Email Notifications (Gmail SMTP)
GMAIL_USER=younesadir@gmail.com
GMAIL_PASSWORD=your-16-character-gmail-app-password
NOTIFICATION_EMAIL=younesadir@gmail.com
